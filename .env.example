# ========================================================
# EduPortal Pro - Environment Variables Configuration
# ========================================================

# Domain DuckDNS & Email untuk Auto-SSL HTTPS via Caddy
# Jika diakses via IP / localhost, cukup biarkan DOMAIN=localhost
DOMAIN=eduportal-sekolah.duckdns.org
ACME_EMAIL=admin@sekolah.sch.id

# Port Konfigurasi Backend Internal
PORT=5000

# OPSI A: Jika menggunakan Database Container bawaan Docker
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Rahadyan27
DB_NAME=eduportal_db
DB_SSL=false

# OPSI B: Jika menggunakan Cloud Database (Neon / Supabase / TiDB)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
# DB_SSL=true

# Keamanan Token JWT
JWT_SECRET=rahasia_eduportal_pro_sekolah_2026_super_safe

# AI Engine Models & API Keys (Multi-Provider Fallback)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
