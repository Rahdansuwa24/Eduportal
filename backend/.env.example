PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=eduportal_db
JWT_SECRET=your_jwt_secret_key_here

# AI Model Providers (Multi-Provider Failover)
# 1. Google Gemini Flash (Dapatkan API Key gratis di https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. Groq Cloud Llama (Dapatkan API Key gratis di https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
